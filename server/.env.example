# 后端环境变量（草案）。复制为 .env 后修改。
NODE_ENV=development
PORT=3000

# PostgreSQL 连接串（本机默认端口；Docker Compose 内 host 为 db）
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_team?schema=public

# JWT 签名密钥，生产环境必须替换为随机 32+ 字符
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 允许的跨域来源，多个用逗号分隔；* 表示全部（仅开发环境）
CORS_ORIGIN=*
