# ============================================================
# 校园组队 App - 环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# 注意：Expo 只内联 EXPO_PUBLIC_ 前缀的变量到客户端代码
# ============================================================

# 数据模式：local = 本地 AsyncStorage（离线可运行，默认）
#           remote = 调用下方 API_BASE_URL 指向的真实后端
EXPO_PUBLIC_DATA_MODE=local

# 后端 REST API 根地址（DATA_MODE=remote 时生效）
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# 请求超时时间（毫秒）
EXPO_PUBLIC_API_TIMEOUT=15000

# ------------------------------------------------------------
# 以下变量仅后端（server/）使用，不要放进 Expo 客户端
# ------------------------------------------------------------
# DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_team?schema=public
# JWT_SECRET=change-me-in-production
# JWT_EXPIRES_IN=7d
# PORT=3000
