{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "remote",
        "EXPO_PUBLIC_API_BASE_URL": "http://139.196.169.146/api",
        "EXPO_PUBLIC_API_TIMEOUT": "15000"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "remote",
        "EXPO_PUBLIC_API_BASE_URL": "http://139.196.169.146/api",
        "EXPO_PUBLIC_API_TIMEOUT": "15000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "remote",
        "EXPO_PUBLIC_API_BASE_URL": "http://139.196.169.146/api",
        "EXPO_PUBLIC_API_TIMEOUT": "15000"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "remote",
        "EXPO_PUBLIC_API_BASE_URL": "http://139.196.169.146/api",
        "EXPO_PUBLIC_API_TIMEOUT": "15000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
